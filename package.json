{
    "name": "@appxdigital/appx-core",
    "version": "0.2.3",
    "description": "Appx Core is a library that provides a set of tools to help you build your application faster.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc && node scripts/copy-frozen.mjs",
        "build:cli": "node scripts/sync-cli-core-version.mjs && npm --prefix cli ci",
        "build:all": "npm run build && npm run build:cli",
        "test": "jest",
        "test:mysql": "DB_PROVIDER=mysql jest",
        "test:postgres": "DB_PROVIDER=postgres jest",
        "test:all": "DB_PROVIDER=mysql jest && DB_PROVIDER=postgres jest",
        "release:beta": "node scripts/release.mjs lib prerelease beta",
        "release:production": "node scripts/release.mjs lib patch",
        "release:cli:beta": "node scripts/release.mjs cli prerelease beta",
        "release:cli:production": "node scripts/release.mjs cli patch"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/appxdigital/appx-core.git"
    },
    "homepage": "https://github.com/appxdigital/appx-core#readme",
    "bugs": {
        "url": "https://github.com/appxdigital/appx-core/issues"
    },
    "dependencies": {
        "ts-morph": "^25.0.0"
    },
    "devDependencies": {
        "@testcontainers/mysql": "^10.28.0",
        "@testcontainers/postgresql": "^10.28.0",
        "@types/express-session": "~1.19.0",
        "@types/jest": "^29.5.14",
        "@types/passport-jwt": "~4.0.1",
        "@types/passport-local": "~1.0.38",
        "@types/supertest": "^6.0.3",
        "jest": "^29.7.0",
        "prettier": "^3.8.3",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.9",
        "typescript": "~5.1.3"
    },
    "peerDependencies": {
        "@apollo/server": "^5.0.0",
        "@as-integrations/express5": "~1.1.2",
        "@nestjs/apollo": "~13.4.5",
        "@nestjs/common": "~11.0.0",
        "@nestjs/config": "~4.0.0",
        "@nestjs/core": "~11.0.0",
        "@nestjs/graphql": "~13.4.5",
        "@nestjs/jwt": "~11.0.0",
        "@nestjs/passport": "~11.0.0",
        "@nestjs/platform-express": "~11.1.6",
        "@nestjs/schedule": "~6.0.0",
        "@paljs/plugins": "~8.1.0",
        "@paralleldrive/cuid2": "~2.2.2",
        "@prisma/client": "~6.5.0",
        "@types/express": "~5.0.0",
        "argon2": "~0.41.1",
        "class-transformer": "~0.5.1",
        "class-validator": "~0.14.1",
        "express": "^5.1.0",
        "express-session": "^1.18.1",
        "graphql-type-json": "^0.3.2",
        "helmet": "^8.0.0",
        "inquirer": "~12.0.1",
        "nestjs-request-context": "~4.0.0",
        "passport": "~0.7.0",
        "passport-jwt": "~4.0.1",
        "passport-local": "~1.0.0",
        "prisma": "~6.5.0",
        "prisma-graphql-type-decimal": "^3.0.0",
        "prisma-nestjs-graphql": "21.1.1",
        "reflect-metadata": "~0.2.0",
        "rxjs": "~7.8.1"
    },
    "files": [
        "dist",
        "docs",
        "CHANGELOG.md",
        "PRERELEASES.md",
        "RELEASING.md"
    ],
    "engines": {
        "node": ">=22.0.0"
    }
