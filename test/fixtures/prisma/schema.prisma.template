// Templated test schema. The placeholders are replaced by test/jest.global-setup.ts.
// Do not edit the generated file (test/fixtures/.runtime/schema.prisma) directly.

datasource db {
  provider = "{{DB_PROVIDER}}"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "{{CLIENT_OUTPUT}}"
}

enum Role {
  ADMIN
  USER
  GUEST
}

model Tenant {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  // The @Role(ADMIN) annotation should make this field invisible to non-ADMIN reads
  password  String   /// @Role(ADMIN)
  // Per-tenant scope used by ABAC condition tests
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  role      Role     @default(USER)
  posts     Post[]
  createdAt DateTime @default(now())
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]
}

model Post {
  id         Int       @id @default(autoincrement())
  title      String
  body       String?
  // Author is required (used in repro: a USER can set authorId to another user's id)
  authorId   Int
  author     User      @relation(fields: [authorId], references: [id])
  // Optional relation — exercises null-allowed proxy code path
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime  @default(now())
}
