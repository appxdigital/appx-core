// Test-fixture schema. Initially produced by cli/scaffold/prisma/schema.prisma.template
// and augmented with domain models below to exercise rich ABAC patterns:
//   - multi-tenant scoping (Tenant.users)
//   - many-to-many via join table (ProjectMember)
//   - optional belongsTo (Task.assignee)
//   - deep nested conditions in permissions (Comment → Task → Project → OR)
//   - shared condition constants (ProjectAccessCondition in permissions.config.ts)
//   - field-level @Role annotation on a non-password field (Project.secretApiKey)
//
// A real consumer's schema would look similar. Keep this file aligned with what
// test/fixtures/scaffold-app/src/config/permissions.config.ts assumes.

datasource db {
  provider = "mysql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator nestgraphql {
  provider = "node node_modules/prisma-nestjs-graphql"
  output   = "../src/generated/"
}

enum Role {
  ADMIN
  USER
}

enum Priority {
  LOW
  HIGH
}

// ----- Framework-owned models (do not remove fields) -----

model User {
  id             Int                 @id @default(autoincrement())
  email          String              @unique
  name           String?
  password       String?             /// @Role(none)
  role           Role                @default(USER) /// @NoWrite
  refreshTokens  UserRefreshToken[]

  // Multi-tenant scoping (optional — register flow does NOT set it)
  tenantId       Int?                /// @NoWrite
  tenant         Tenant?             @relation(fields: [tenantId], references: [id])

  // Project ownership + membership
  ownedProjects  Project[]
  memberships    ProjectMember[]

  // Authored content
  comments       Comment[]
  assignedTasks  Task[]              @relation("AssigneeTasks")
  reviewedTasks  Task[]              @relation("ReviewerTasks")

  // 1:1 profile (optional — some users have none)
  profile        UserProfile?

  // Self-relation: manager hierarchy
  managerId      Int?
  manager        User?               @relation("UserHierarchy", fields: [managerId], references: [id])
  reports        User[]              @relation("UserHierarchy")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime
  userId    Int?
}

model UserRefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique @db.VarChar(255)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

// ----- Domain models for ABAC test coverage -----

model Tenant {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]
}

model Project {
  id           Int             @id @default(autoincrement())
  name         String
  ownerId      Int
  owner        User            @relation(fields: [ownerId], references: [id])
  members      ProjectMember[]
  tasks        Task[]
  status       String          @default("active")
  // Implicit M:N — Prisma manages the hidden join table
  tags         Tag[]
  // Sensitive field — only ADMIN can read it (proxy field omission)
  secretApiKey String?         /// @Role(ADMIN)
  createdAt    DateTime        @default(now())
}

model ProjectMember {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String  @default("contributor")    // "manager" | "contributor"

  @@unique([projectId, userId])
  @@index([userId])
}

model Task {
  id         Int       @id @default(autoincrement())
  title      String
  status     String    @default("open")
  projectId  Int
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Optional belongsTo — exercises the proxy's null-allowed code path
  assigneeId Int?
  assignee   User?     @relation("AssigneeTasks", fields: [assigneeId], references: [id])
  // Second named relation to User — disambiguation the proxy must respect
  reviewerId Int?
  reviewer   User?     @relation("ReviewerTasks", fields: [reviewerId], references: [id])
  comments   Comment[]
  createdAt  DateTime  @default(now())
}

model Comment {
  id        Int      @id @default(autoincrement())
  body      String   @db.Text
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  // Self-relation: threaded replies
  parentId  Int?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
}

// 1:1 — exercises @unique FK + the proxy's belongsTo branch at cardinality 1
model UserProfile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String
  billingInfo String? /// @Role(ADMIN)
}

// Implicit M:N — no join model declared; Prisma manages the hidden table
model Tag {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  projects Project[]
}

// Scalar-type coverage — one writable field per generate-dtos `mapField` branch,
// so the generated CRUD DTOs (and the controller override compiled by
// buildFixtureApp/tsc) exercise every type mapping, not just String/Int. This is
// the guard that would have caught the DateTime-as-string bug: `dueAt` below.
// NOTE: Decimal and BigInt are intentionally omitted — their write-DTO
// representation over HTTP is still an open question; scalar lists are omitted
// because MySQL (one of the two matrix providers) doesn't support them.
model TypeSample {
  id        Int       @id @default(autoincrement())
  text      String
  flag      Boolean
  count     Int
  ratio     Float
  dueAt     DateTime
  priority  Priority
  meta      Json
  noteOpt   String?
  flagOpt   Boolean?
  dueAtOpt  DateTime?
  createdAt DateTime  @default(now()) // server-managed — must be excluded from the DTO
}
